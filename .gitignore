# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
dist-*/
.venv/
venv/

# --- пакеты Velopack (сотни мегабайт, место им в GitHub Releases) ---
Releases/
Releases-*/

# --- runtime artefacts (belong in the user profile, never in the repo) ---
_crash.log
_session.alive
_stats.jsonl
_streaming_debug.log
settings.ini
replacements.json
dictionary.txt
history/
models/
icons/

# --- work-in-progress leftovers ---
*.bak
*.t[0-9][0-9][0-9]bak
_smoke_*
_bench_*
_repro_*

# --- audio / transcripts (personal data, must not be committed) ---
*.wav
*.mp3
*.f32raw
*.raw
*.callmeta.json
# Exception: synthetic test fixtures (a generated sine wave, no speech, no personal
# data). The mp3 one is not reproducible at test time — encoding it would require a
# bundled encoder — so it travels with the repository (T-351).
!tests/fixtures/*.mp3
!tests/fixtures/*.wav

# --- editors / OS ---
.vscode/
.idea/
Thumbs.db
desktop.ini
